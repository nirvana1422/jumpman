<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>おばちゃん登るゲーム（デモ）</title>
<style>
  html,body { margin:0; padding:0; background:#111; height:100%; }
  #game-container { width:100%; height:100vh; display:block; }
  .hint { position:fixed; left:8px; bottom:8px; color:#ddd; font-family:monospace; font-size:12px; z-index:10; }
</style>
<script src="https://cdn.jsdelivr.net/npm/phaser@3.55.2/dist/phaser.min.js"></script>
</head>
<body>
<div id="game-container"></div>
<div class="hint">タップ／クリックで上昇＋左右速度アップ。スペースでも可。</div>

<script>
/*
  簡易登るゲーム（Phaser 3）
  主な機能：
  - 自動左右往復するプレイヤー。タップで上に飛び、横速度が一時的に増加。
  - 背景が下にスクロール（登っている見た目）。
  - 上から来る壁（ギャップ）があり、ギャップを通らないと衝突。
  - 敵は動き回る。上から踏むと倒れる（得点）。
  - アイテム：ライフ回復 / 一定時間無敵 / 一定時間壁すり抜け（フェーズ）。
  - レベル上がるごとに速度・出現頻度・背景／音楽が変化。
*/

/* ====== 設定 ====== */
const GAME_WIDTH = 480;
const GAME_HEIGHT = 800;

const config = {
  type: Phaser.AUTO,
  width: GAME_WIDTH,
  height: GAME_HEIGHT,
  parent: 'game-container',
  backgroundColor: '#122',
  physics: {
    default: 'arcade',
    arcade: {
      gravity: { y: 800 },
      debug: false
    }
  },
  scene: { preload, create, update }
};

const game = new Phaser.Game(config);

/* ====== グローバル変数（簡潔に） ====== */
let player, cursors;
let wallsGroup, enemyGroup, itemGroup;
let bg;
let score = 0;
let scoreText, livesText, levelText, powerText;
let lives = 3;
let level = 1;
let scrollSpeed = 60; // 背景スクロール速さ（px/s）
let wallSpawnTimer = 0;
let enemySpawnTimer = 0;
let itemSpawnTimer = 0;
let baseHorizSpeed = 80;
let horizSpeedBuff = 0;
let horizBuffTimer = 0;
let invincibleTimer = 0;
let phaseTimer = 0;
let isGameOver = false;

/* WebAudio の簡易BGM */
let audioCtx, bgOsc, bgGain;

/* ====== preload ====== */
function preload() {
  // ここでは外部画像を使わないため、テクスチャを動的生成する
  this.textures.createCanvas('pattern', 64, 64).context.fillStyle = '#244';
  const ctx = this.textures.get('pattern').getContext();
  // 簡単な斜めラインパターン
  ctx.fillStyle = '#2a4';
  ctx.fillRect(0,0,64,64);
  ctx.strokeStyle = '#163';
  ctx.lineWidth = 2;
  for (let i=-64;i<128;i+=8){
    ctx.beginPath();
    ctx.moveTo(i,0);
    ctx.lineTo(i+64,64);
    ctx.stroke();
  }
  this.textures.get('pattern').refresh();
}

/* ====== create ====== */
function create() {
  const scene = this;
  // 背景タイルを作る（Canvas テクスチャ + tileSprite）
  bg = this.add.tileSprite(0,0, GAME_WIDTH, GAME_HEIGHT, 'pattern').setOrigin(0);
  bg.setTint(0x334455);

  // groups
  wallsGroup = this.physics.add.group();
  enemyGroup = this.physics.add.group();
  itemGroup = this.physics.add.group();

  // player（円キャラ、physics body は四角だが当たりは少し緩め）
  player = this.add.circle(GAME_WIDTH/2, GAME_HEIGHT*0.7, 20, 0xffcc66);
  this.physics.add.existing(player);
  player.body.setCollideWorldBounds(true);
  player.body.setBounce(0);
  player.body.setSize(32,32,true);
  player.body.setMaxVelocity(400, 800);
  player.flip = false;

  // HUD
  scoreText = this.add.text(10,10,'Score: 0',{font:'16px monospace', fill:'#fff'});
  livesText = this.add.text(10,30,'Lives: 3',{font:'16px monospace', fill:'#fff'});
  levelText = this.add.text(10,50,'Level: 1',{font:'16px monospace', fill:'#fff'});
  powerText = this.add.text(10,70,'Power: -',{font:'14px monospace', fill:'#fff'});

  // 入力
  this.input.on('pointerdown', () => doTap(scene) );
  cursors = this.input.keyboard.createCursorKeys();
  this.input.keyboard.on('keydown-SPACE', () => doTap(scene) );

  // 衝突監視（walls/enemy/item）
  this.physics.add.overlap(player, itemGroup, collectItem, null, scene);
  this.physics.add.collider(player, wallsGroup, hitWall, null, scene);
  this.physics.add.collider(player, enemyGroup, hitEnemy, null, scene);
  this.physics.add.collider(enemyGroup, wallsGroup); // 敵は壁にぶつかる

  // WebAudio 簡易初期化
  try {
    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    bgOsc = audioCtx.createOscillator();
    bgGain = audioCtx.createGain();
    bgOsc.type = 'sine';
    bgOsc.frequency.value = 220;
    bgGain.gain.value = 0.02;
    bgOsc.connect(bgGain);
    bgGain.connect(audioCtx.destination);
    bgOsc.start();
  } catch(e){
    audioCtx = null;
  }

  // 初速の左右成分（自動往復）
  player.horizSpeed = baseHorizSpeed;
  player.dir = 1; // 1: 右, -1: 左

  // 初の壁群をいくつか作っておく
  for (let i=0;i<3;i++){
    spawnWall(this, i * (GAME_HEIGHT/3) - 100);
  }

  // 初の敵／アイテムは遅めに
  enemySpawnTimer = 2000;
  itemSpawnTimer = 6000;
}

/* ====== update ====== */
function update(time, delta) {
  if (isGameOver) return;
  const dt = delta / 1000;

  // 背景スクロール（下方向に動かす -> プレイヤーは上っているように見える）
  bg.tilePositionY += scrollSpeed * dt;

  // 自動左右往復（端に来たら反転）
  let effectiveHoriz = (baseHorizSpeed + horizSpeedBuff) * player.dir;
  player.body.setVelocityX(effectiveHoriz);
  if (player.x < 24) { player.dir = 1; player.x = 24; }
  if (player.x > GAME_WIDTH - 24) { player.dir = -1; player.x = GAME_WIDTH - 24; }

  // 横速度バフの時間経過
  if (horizBuffTimer > 0) {
    horizBuffTimer -= delta;
    if (horizBuffTimer <= 0) { horizSpeedBuff = 0; }
  }

  // 無敵・フェーズタイマー経過
  if (invincibleTimer > 0) {
    invincibleTimer -= delta;
    if (invincibleTimer <= 0) { invincibleTimer = 0; }
  }
  if (phaseTimer > 0) {
    phaseTimer -= delta;
    if (phaseTimer <= 0) { phaseTimer = 0; }
  }

  // HUD 更新
  scoreText.setText('Score: ' + score);
  livesText.setText('Lives: ' + lives);
  levelText.setText('Level: ' + level);
  let ptxt = [];
  if (invincibleTimer>0) ptxt.push('無敵:' + Math.ceil(invincibleTimer/1000) + 's');
  if (phaseTimer>0) ptxt.push('すり抜け:' + Math.ceil(phaseTimer/1000) + 's');
  powerText.setText('Power: ' + (ptxt.length? ptxt.join(' | ') : 'なし'));

  // 上制限（上まで行っても死なない）
  if (player.y < 40) {
    player.y = 40;
    player.body.velocity.y = Math.max(0, player.body.velocity.y);
  }

  // 下に落ちたらゲームオーバー
  if (player.y > GAME_HEIGHT + 60) {
    return gameOver(this);
  }

  // 壁／敵／アイテム生成タイマー
  wallSpawnTimer += delta;
  enemySpawnTimer += delta;
  itemSpawnTimer += delta;

  const wallInterval = Math.max(900 - level*50, 400); // レベル上がると速く出る
  const enemyInterval = Math.max(1200 - level*60, 400);
  const itemInterval = Math.max(4000 - level*200, 2000);

  if (wallSpawnTimer > wallInterval) {
    spawnWall(this, -80);
    wallSpawnTimer = 0;
  }
  if (enemySpawnTimer > enemyInterval) {
    spawnEnemy(this, -40);
    enemySpawnTimer = 0;
  }
  if (itemSpawnTimer > itemInterval) {
    spawnItem(this, -40);
    itemSpawnTimer = 0;
  }

  // 敵に「踏まれた」判定（簡易）
  enemyGroup.getChildren().forEach(e => {
    // 死んでいるなら skip
    if (!e.active) return;
    // 歩行（横移動は既に velocity.x に設定）
    // プレイヤーが上から接触すると敵を倒す
    if (player.body.velocity.y > 0 && Math.abs(player.x - e.x) < 28 && (player.y + 18) < e.y) {
      // 踏みつけ判定：もしプレイヤーが敵の上にきている
      killEnemy(this, e);
      // プレイヤーに小さな跳ねをつける
      player.body.setVelocityY(-220);
    }
    // 敵が画面外に出たら消す
    if (e.y > GAME_HEIGHT + 80 || e.x < -80 || e.x > GAME_WIDTH + 80) {
      e.destroy();
    }
  });

  // 壁やアイテムも下まで来たら消す
  wallsGroup.getChildren().forEach(w => { if (w.y > GAME_HEIGHT + 120) w.destroy(); });
  itemGroup.getChildren().forEach(it => { if (it.y > GAME_HEIGHT + 80) it.destroy(); });

  // レベルアップ判定（スコア閾値）
  let needed = level * 10; // シンプル閾値（10,20,30...）
  if (score >= needed) {
    levelUp(this);
  }

  // BGM 変化（WebAudio があれば）: 周波数をレベルに応じて上げる
  if (audioCtx && bgOsc) {
    bgOsc.frequency.value = 220 + (level-1) * 40;
    // 背景色をレベルで微妙にシフト
    const t = Math.min(level/10, 1);
    const r = Math.floor(34 + 120*t);
    const g = Math.floor(68 + 60*t);
    const b = Math.floor(85 + 40*t);
    bg.setTint( (r<<16) | (g<<8) | b );
  }
}

/* ====== 入力処理: タップ ====== */
function doTap(scene) {
  if (isGameOver) {
    // リスタート
    restart(scene);
    return;
  }
  // 上向きに短い推力を与える
  player.body.setVelocityY(-300);
  // 横速度バフを一時的に付与
  horizSpeedBuff = 160; // 一時的な追加速度
  horizBuffTimer = 350; // ミリ秒
}

/* ====== スポーン系 ====== */
function spawnWall(scene, startY = -80) {
  // ギャップ幅と位置をランダム化
  const gapWidth = Phaser.Math.Between(90, 160);
  const gapX = Phaser.Math.Between(60, GAME_WIDTH - 60 - gapWidth);

  // 左パーツ
  const leftW = scene.add.rectangle((gapX/2), startY, gapX, 40, 0x444455);
  scene.physics.add.existing(leftW);
  leftW.body.setImmovable(true);
  leftW.body.setVelocityY(scrollSpeed + level*10);
  leftW.isWall = true;
  wallsGroup.add(leftW);

  // 右パーツ
  const rightW = scene.add.rectangle(gapX + gapWidth + (GAME_WIDTH - (gapX + gapWidth))/2, startY, GAME_WIDTH - (gapX + gapWidth), 40, 0x444455);
  scene.physics.add.existing(rightW);
  rightW.body.setImmovable(true);
  rightW.body.setVelocityY(scrollSpeed + level*10);
  rightW.isWall = true;
  wallsGroup.add(rightW);

  // 少し変化をつけてギャップの位置を示す装飾（任意）
}

function spawnEnemy(scene, startY = -40) {
  const ex = Phaser.Math.Between(40, GAME_WIDTH-40);
  const e = scene.add.rectangle(ex, startY, 28, 28, 0xff6666);
  scene.physics.add.existing(e);
  e.body.setVelocityY(scrollSpeed + 60 + level*15);
  // 横移動ランダム
  const sideways = Phaser.Math.Between(-80, 80);
  e.body.setVelocityX(sideways);
  e.body.setBounce(1,0);
  e.body.setCollideWorldBounds(true);
  e.scoreVal = 3;
  enemyGroup.add(e);
}

function spawnItem(scene, startY = -40) {
  const ix = Phaser.Math.Between(40, GAME_WIDTH-40);
  // 種類をランダムに決定
  const kind = Phaser.Math.RND.pick(['life','inv','phase']);
  const color = kind === 'life' ? 0x66ff66 : (kind === 'inv' ? 0x66ccff : 0xffff66);
  const it = scene.add.circle(ix, startY, 12, color);
  scene.physics.add.existing(it);
  it.body.setVelocityY(scrollSpeed + 40 + level*10);
  it.kind = kind;
  itemGroup.add(it);
}

/* ====== 衝突・アイテム処理 ====== */
function collectItem(playerObj, it) {
  if (!it.active) return;
  const kind = it.kind;
  if (kind === 'life') {
    lives = Math.min(9, lives + 1);
  } else if (kind === 'inv') {
    invincibleTimer = 6000; // 6秒
  } else if (kind === 'phase') {
    phaseTimer = 4000; // 4秒
  }
  // 簡易エフェクト（縮小して消す）
  it.destroy();
  score += 1;
}

function hitWall(playerObj, wall) {
  // フェーズ中は当たり判定を無視（壁を貫通）
  if (phaseTimer > 0) {
    return;
  }
  // 当たる場合はダメージ unless invincible
  if (invincibleTimer > 0) {
    // if invincible, bounce off harmlessly
    player.body.setVelocityY(-150);
    return;
  }
  takeDamage(this, 1);
}

function hitEnemy(playerObj, enemy) {
  // このコリジョンは「通常接触」扱い。踏みつけは別に判定している。
  if (phaseTimer > 0) return;
  if (invincibleTimer > 0) {
    // 無敵なら敵は無視
    return;
  }
  takeDamage(this, 1);
}

/* ====== ダメージ・ゲームオーバー ====== */
function takeDamage(scene, amt) {
  lives -= amt;
  invincibleTimer = 1200; // 短い無敵時間を付与
  // 衝撃で少し上昇
  player.body.setVelocityY(-220);
  if (lives <= 0) {
    gameOver(scene);
  }
}

function gameOver(scene) {
  isGameOver = true;
  // 表示
  const go = scene.add.text(GAME_WIDTH/2, GAME_HEIGHT/2, 'GAME OVER\nタップでリスタート', { font:'24px monospace', fill:'#fff', align:'center' }).setOrigin(0.5);
  // 停止：全グループを止める
  wallsGroup.getChildren().forEach(w => w.body && w.body.setVelocity(0));
  enemyGroup.getChildren().forEach(e => e.body && e.body.setVelocity(0));
  itemGroup.getChildren().forEach(it => it.body && it.body.setVelocity(0));
  player.body.setVelocity(0);
  // stop audio gently
  if (audioCtx && bgGain) bgGain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 0.5);
}

/* ====== 敵を倒す処理 ====== */
function killEnemy(scene, e) {
  if (!e.active) return;
  score += e.scoreVal || 1;
  // 簡易スコアエフェクト
  const txt = scene.add.text(e.x, e.y, '+' + (e.scoreVal||1), {font:'14px monospace', fill:'#fff'}).setOrigin(0.5);
  scene.tweens.add({ targets: txt, y: e.y-20, alpha:0, duration:700, onComplete: ()=>txt.destroy() });
  e.destroy();
}

/* ====== レベルアップ ====== */
function levelUp(scene) {
  level++;
  // 速度の漸増
  scrollSpeed += 18;
  // 敵や壁の出現頻度等は update 内で反映される（wallInterval など）
  // BGM 音量を少し上げる
  if (audioCtx && bgGain) {
    bgGain.gain.value = Math.min(0.06, bgGain.gain.value + 0.01);
  }
}

/* ====== リスタート ====== */
function restart(scene) {
  // リセット
  wallsGroup.clear(true,true);
  enemyGroup.clear(true,true);
  itemGroup.clear(true,true);
  score = 0;
  lives = 3;
  level = 1;
  scrollSpeed = 60;
  horizSpeedBuff = 0; horizBuffTimer = 0;
  invincibleTimer = 0; phaseTimer = 0;
  isGameOver = false;
  scoreText.setText('Score: 0');
  livesText.setText('Lives: 3');
  levelText.setText('Level: 1');
  // reset player pos
  player.x = GAME_WIDTH/2; player.y = GAME_HEIGHT*0.7;
  player.body.setVelocity(0,0);

  // restart audio gain
  if (audioCtx && bgGain) bgGain.gain.value = 0.02;

  // pre-spawn a few walls
  for (let i=0;i<3;i++){
    spawnWall(scene, i * (GAME_HEIGHT/3) - 100);
  }
}

/* ====== ユーティリティ（デバッグ用） ====== */
// none for now

</script>
</body>
</html>
